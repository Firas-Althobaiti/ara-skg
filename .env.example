# OpenAI API key (if using GPT‑4o / mini)
OPENAI_API_KEY=***

# Neo4j connection (default credentials in docker‑compose)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=testpassword

# Vector store location (Chroma by default)
VECTOR_DIR=./vector_store

# Knowledge-graph backend: "networkx" (offline JSON store, default — used by
# `make demo` and the CLI) or "neo4j" (requires `make up`)
ARA_KG_BACKEND=networkx
# JSON file used by the NetworkX backend (demo writes artifacts/demo_kg.json)
ARA_KG_STORE=kg_store.json

# LangChain / LangSmith tracing (optional)
LANGCHAIN_TRACING_V2=false 
LANGCHAIN_API_KEY=***
LANGSMITH_PROJECT=ara-skg
